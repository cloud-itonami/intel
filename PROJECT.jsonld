          ],
          "@type": "CreativeWork",
          "name": "etzhayyim project intel Scheduler",
          "identifier": "etzhayyim-project-intel/scheduler",
          "description": "Project schedule (milestones) and blockers.",
          "dateCreated": "2026-02-15T04:25:26+00:00",
          "milestones": [
            {
              "@type": "DefinedTerm",
              "name": "SpinApp design complete",
              "description": "Taxonomy, command/query split, data model, and component topology documented.",
              "dateCreated": "2026-03-12T00:00:00Z"
            },
            {
              "@type": "DefinedTerm",
              "name": "Scaffold initial SpinApp",
              "description": "Create wasm app folder, spin.toml, and k8s/spinapp.yaml for intel gateway/query/ui surfaces."
            },
            {
              "@type": "DefinedTerm",
              "name": "Define public contracts",
              "description": "Add WIT and Connect gRPC proto for IntelQueryService and internal workflow operations."
            }
          ],
          "blockers": []
        }
      }
    ]
