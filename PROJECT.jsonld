  "@type": "Project",
  "identifier": "etzhayyim-project-intel",
  "name": "etzhayyim project intel",
  "status": "DesignComplete",
  "description": "Multi-INT fusion SpinApp for lawful collection, normalization, correlation, and query across OSINT, HUMINT, SIGINT, GEOINT, MASINT, cyber, economic, technical, and behavioral intelligence families.",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "description": "Summary of the capabilities this project is responsible for (CV-1).",
    "terms": [
      {
        "@type": "DefinedTerm",
        "name": "Multi-INT Collection",
        "description": "Collect observations from public, human, signal, geospatial, cyber, economic, and scientific source families through lawful connectors."
      },
      {
        "@type": "DefinedTerm",
        "name": "Evidence Normalization",
        "description": "Normalize heterogeneous source payloads into common observation, entity, and link projections."
      },
      {
        "@type": "DefinedTerm",
        "name": "Fusion Scoring",
        "description": "Score hypotheses and event probabilities by weighting cross-INT evidence."
      },
      {
        "@type": "DefinedTerm",
        "name": "Case and Alert Query",
        "description": "Expose typed query APIs for cases, observations, graphs, alerts, and source coverage."
      }
    ]
  },
  "survivalIndicators": [
    {
      "@type": "PropertyValue",
      "identifier": "requests",
      "name": "Requests",
      "description": "Request count (traffic) as a basic survival indicator.",
      "unitText": "count",
      "value": null,
      "ingestKey": "requests",
      "window": "1d",
      "valueUpdatedAt": null
    },
    {
      "@type": "PropertyValue",
      "identifier": "gccCredit",
      "name": "GCC Credit",
      "description": "GCC credit balance (or net credit change) as a basic survival indicator.",
      "unitText": "GCC",
      "value": null,
      "ingestKey": "gccCredit",
      "window": "1d",
      "valueUpdatedAt": null
    }
  ],
  "scheduler": "scheduler.jsonld",
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
